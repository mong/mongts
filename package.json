{
  "name": "mongts",
  "packageManager": "pnpm@11.1.3",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "export": "turbo run export",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types",
    "check-format": "turbo run check-format",
    "prepare": "husky",
    "knip": "knip"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "24.12.2",
    "commitlint": "^20.5.2",
    "eslint": "10.3.0",
    "globals": "17.5.0",
    "husky": "^9.1.7",
    "knip": "6.11.0",
    "lint-staged": "16.4.0",
    "prettier": "3.8.3",
    "turbo": "2.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-leading-blank": [
        1,
        "always"
      ],
      "body-max-line-length": [
        2,
        "always",
        100
      ],
      "footer-leading-blank": [
        1,
        "always"
      ],
      "footer-max-line-length": [
        2,
        "always",
        100
      ],
      "header-max-length": [
        2,
        "always",
        100
      ],
      "header-trim": [
        2,
        "always"
      ],
      "subject-case": [
        2,
        "never",
        [
          "sentence-case",
          "start-case",
          "pascal-case",
          "upper-case"
        ]
      ],
      "subject-empty": [
        2,
        "never"
      ],
      "subject-full-stop": [
        2,
        "never",
        "."
      ],
      "type-case": [
        2,
        "always",
        "lower-case"
      ],
      "type-empty": [
        2,
        "never"
      ],
      "type-enum": [
        2,
        "always",
        [
          "build",
          "chore",
          "ci",
          "docs",
          "feat",
          "fix",
          "perf",
          "refactor",
          "revert",
          "style",
          "test"
        ]
      ]
    }
  }
}
