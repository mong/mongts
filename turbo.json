{
  "$schema": "https://turbo.build",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "build/**"]
    },
    "export": {
      "dependsOn": ["^build"],
      "outputs": ["out/**"]
    },
    "check-format": {},
    "check-types": {},
    "test": {
      "cache": false
    },
    "format": {},
    "lint": {},
    "start": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DB_PORT"]
    }
  }
}
